  <url type="website">https://github.com/pawelcel/EasyPDM</url>
  <url type="documentation">https://github.com/pawelcel/EasyPDM-FreeCAD-Addon/blob/main/docs/README.md</url>
  <url type="bugtracker">https://github.com/pawelcel/EasyPDM-FreeCAD-Addon/issues</url>
  <tag>pdm</tag>
  <tag>data-management</tag>
  <tag>assembly</tag>
  <tag>drawing</tag>
  <tag>collaboration</tag>
